#!/usr/bin/python3
"""Filtro CUPS: PDF -> ESC/POS raster para la mini termica YHK-59A8.

CUPS lo invoca con: jobid usuario titulo copias opciones [archivo]
Si no hay archivo, el PDF llega por stdin. La salida cruda va a stdout,
que el backend copia al socket bluetooth.

La secuencia de bytes es la de cat-printer.py, que es lo unico que se
comprobo que esta impresora entiende. No es ESC/POS generico:
`1D 49 F0 19` es propio de este firmware, y la imagen va rotada 180.
"""
import os
import subprocess
import sys
import tempfile

from PIL import Image, ImageChops, ImageOps

ANCHO = 384          # puntos del cabezal (48 mm a 203 dpi)
ANCHO_ETIQUETA = 380 # 47.5 mm de los 48 del cabezal: se usa casi todo el ancho
                     # y quedan 2 px por lado para que el borde punteado no se
                     # coma el limite del cabezal. Calibrar aca el margen.
MARGEN_V = 8         # ~1 mm de aire arriba y abajo del contenido
DPI = 406            # 2x los 203 dpi del cabezal: sobra definicion para
                     # recortar y reescalar sin que el texto quede blando
BLOQUE_FILAS = 255   # ponytail: se probaron 500 filas de una; 255 por bloque
                     # es el limite conservador de GS v 0. Si algun dia hay
                     # que acelerar, subir esto y medir.


def log(msg):
    # CUPS recoge stderr en /var/log/cups/error_log
    sys.stderr.write("ERROR: rastertoyhk: %s\n" % msg)
    sys.stderr.flush()


def recortar_blanco(im):
    """Recorta todo el blanco que rodea al contenido, en ambos ejes.

    Sin el recorte vertical cada etiqueta escupe la hoja entera del PPD en
    blanco y se come el rollo. El horizontal es el que arregla el ancho:
    los margenes laterales que manda el navegador no son fiables (ver
    a_384), asi que se tiran y se reconstruyen.
    """
    gris = im.convert("L")
    fondo = Image.new("L", gris.size, 255)
    caja = ImageChops.difference(gris, fondo).getbbox()
    if caja is None:
        return None  # pagina vacia: no se imprime nada
    return im.crop(caja)


def a_384(im):
    """Escala la etiqueta a 45 mm y la centra en los 48 mm del cabezal.

    El ancho que manda el navegador no sirve como referencia: con una
    impresora seleccionada Chrome no adopta el @page size, elige el papel
    del PPD y escala el contenido por su cuenta (medido: un marco de 45 mm
    salio a 30 mm, pegado a la izquierda y con 14 mm muertos a la derecha).
    Fijar el ancho aca hace que el resultado en papel no dependa de lo que
    decida el dialogo de impresion.
    """
    alto = max(1, round(im.height * (ANCHO_ETIQUETA / im.width)))
    im = im.convert("L").resize((ANCHO_ETIQUETA, alto), Image.LANCZOS)
    hoja = Image.new("L", (ANCHO, alto + 2 * MARGEN_V), 255)
    hoja.paste(im, ((ANCHO - ANCHO_ETIQUETA) // 2, MARGEN_V))
    return hoja


def a_escpos(im):
    """Convierte una pagina ya recortada en bloques GS v 0."""
    im = a_384(im)
    # Rareza real de esta unidad: sin rotar sale de cabeza (verificado en papel)
    im = im.rotate(180)
    # ESC/POS quiere 1 = punto negro; en PIL modo '1' el 1 es blanco
    im = ImageOps.invert(im.convert("L"))
    # ponytail: umbral duro sin dithering en vez del convert("1") default de
    # PIL (Floyd-Steinberg). El dithering reparte el gris del antialiasing de
    # pdftoppm en un punteado, lo que deja los trazos finos del texto grises
    # en vez de negro solido. Bajar el umbral (no 128) mete tambien los bordes
    # antialiaseados como negro pleno -> texto mas grueso y mas oscuro.
    im = im.point(lambda p: 255 if p > 60 else 0).convert("1")

    datos = im.tobytes()
    bytes_por_fila = ANCHO // 8
    salida = bytearray()
    for y0 in range(0, im.height, BLOQUE_FILAS):
        filas = min(BLOQUE_FILAS, im.height - y0)
        trozo = datos[y0 * bytes_por_fila:(y0 + filas) * bytes_por_fila]
        salida += b"\x1d\x76\x30\x00"
        salida += bytes((bytes_por_fila % 256, bytes_por_fila // 256))
        salida += bytes((filas % 256, filas // 256))
        salida += trozo
    return bytes(salida)


def paginas_del_pdf(ruta_pdf, tmp):
    """Rasteriza el PDF con definicion de sobra; a_384 fija el ancho final."""
    prefijo = os.path.join(tmp, "pag")
    subprocess.run(
        ["pdftoppm", "-r", str(DPI), "-gray", "-png", ruta_pdf, prefijo],
        check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
    )
    return sorted(
        os.path.join(tmp, f) for f in os.listdir(tmp)
        if f.startswith("pag") and f.endswith(".png")
    )


def main():
    copias = 1
    if len(sys.argv) > 4:
        try:
            copias = max(1, int(sys.argv[4]))
        except ValueError:
            copias = 1

    with tempfile.TemporaryDirectory() as tmp:
        ruta_pdf = sys.argv[6] if len(sys.argv) > 6 and sys.argv[6] else None
        if ruta_pdf is None:
            ruta_pdf = os.path.join(tmp, "entrada.pdf")
            with open(ruta_pdf, "wb") as f:
                f.write(sys.stdin.buffer.read())

        try:
            pngs = paginas_del_pdf(ruta_pdf, tmp)
        except subprocess.CalledProcessError as e:
            log("pdftoppm fallo: %s" % e.stderr.decode("utf8", "replace").strip())
            return 1
        if not pngs:
            log("el PDF no produjo ninguna pagina")
            return 1

        out = sys.stdout.buffer
        out.write(b"\x1b\x40")          # init
        out.write(b"\x1d\x49\xf0\x19")  # inicio de impresion (propio del firmware)

        impresas = 0
        for _ in range(copias):
            for png in pngs:
                with Image.open(png) as im:
                    pagina = recortar_blanco(im)
                    if pagina is None:
                        continue
                    out.write(a_escpos(pagina))
                    out.write(b"\x0a\x0a\x0a")  # separacion entre etiquetas
                    impresas += 1
                    # Contabilidad de CUPS: sin esto el page_log dice
                    # "total 0" y no se distingue de un trabajo que no imprimio
                    sys.stderr.write("PAGE: %d 1\n" % impresas)
                    sys.stderr.flush()

        if impresas == 0:
            log("todas las paginas venian en blanco")
        # ponytail: 2 LF en vez de 4. Con el espaciado default de ESC/POS
        # (1/6", ~4.23mm por LF) esto recorta ~8.5mm de sobrante al final.
        # Es una estimacion del espaciado default del firmware, no medida
        # directa en mm; si sigue sobrando o corta antes de tiempo, calibrar
        # aca sumando o restando LFs.
        out.write(b"\x0a\x0a")  # avance final para poder cortar
        out.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
